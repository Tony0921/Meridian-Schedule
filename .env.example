# 程式不自動載入此檔；請由 shell 或 systemd EnvironmentFile 載入。
GITHUB_REPOSITORY=Tony0921/Meridian-Schedule
GITHUB_TOKEN=
# v2.1 核心：schedule_ingestion 工作表 Publish to Web 的公開 CSV URL。
# Actions 使用同名 Repository Variable；不需要 Google 憑證或 API Key。
SCHEDULE_CSV_URL=
# 選配公開 RSS 補漏：JSON object，key 為 members.json 的 id。
X_PUBLIC_FEEDS={}
# 以下僅供選配的舊版 X API / AI API 路徑。
X_API_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=
POST_SOURCE=x-api
REVIEW_ALL=true
AUTO_MERGE_CONFIDENCE=0.95
PR_CONFIDENCE=0.70
RECONCILE_HOURS=6,18
