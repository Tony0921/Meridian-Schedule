[Unit]
Description=Meridian Schedule Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meridian
WorkingDirectory=/opt/meridian-schedule
EnvironmentFile=/etc/meridian-schedule.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m collector.main listen
Restart=on-failure
RestartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/meridian-schedule/.local

[Install]
WantedBy=multi-user.target
