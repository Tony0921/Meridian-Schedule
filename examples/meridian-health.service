[Unit]
Description=Check Meridian ingestion and production data

[Service]
Type=oneshot
User=meridian
WorkingDirectory=/opt/meridian-schedule
ExecStart=/usr/bin/python3 -m scripts.health_check --ingestion-db .local/ingestion/ingestion.db
# 啟用公開來源補漏後可加 --reconciliation .local/reconciliation/missing-posts.json。
NoNewPrivileges=true
