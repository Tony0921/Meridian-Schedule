[Unit]
Description=Import Meridian Schedule observations
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=meridian
WorkingDirectory=/opt/meridian-schedule
EnvironmentFile=/etc/meridian-schedule.env
ExecStart=/usr/bin/python3 -m scripts.import_sheet
# 完成本機審核後，若要自動建立 PR，再將 ExecStart 改為加上 --publish。
NoNewPrivileges=true
UMask=0077
