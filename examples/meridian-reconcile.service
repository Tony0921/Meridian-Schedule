[Unit]
Description=Reconcile Meridian public sources without paid APIs
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=meridian
WorkingDirectory=/opt/meridian-schedule
EnvironmentFile=/etc/meridian-schedule.env
ExecStart=/usr/bin/python3 -m scripts.reconcile_posts
NoNewPrivileges=true
UMask=0077
