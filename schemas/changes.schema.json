{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interpreter proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["classification", "confidence", "changes", "reason"],
  "properties": {
    "classification": {"type": "string", "enum": ["weekly_schedule", "schedule_change", "sudden_stream", "cancellation", "postponement", "day_off", "irrelevant", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason": {"type": "string", "minLength": 1},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation"],
        "properties": {
          "operation": {"type": "string", "enum": ["insert", "update", "cancel", "ignore"]},
          "match": {"$ref": "#/$defs/match"},
          "set": {"$ref": "#/$defs/fields"}
        }
      }
    }
  },
  "$defs": {
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "member_id": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "title": {"type": "string", "minLength": 1},
        "platform": {"type": ["string", "null"], "enum": ["youtube", "twitch", "none", "unknown", "other", null]},
        "time": {"type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member_id": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "time": {"type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "timezone": {"type": "string", "const": "Asia/Taipei"},
        "title": {"type": "string", "minLength": 1},
        "platform": {"type": ["string", "null"], "enum": ["youtube", "twitch", "none", "unknown", "other", null]},
        "url": {"type": ["string", "null"], "format": "uri"},
        "status": {"type": "string", "enum": ["scheduled", "changed", "cancelled", "postponed", "live", "finished", "day_off", "working_day", "tbd"]}
      }
    }
  }
}
