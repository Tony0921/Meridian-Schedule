{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["ingestion_id", "source", "post_id", "member_id", "published_at", "discovered_at", "source_url", "post_text", "media_urls", "classification", "confidence", "discovery_source", "source_quality", "changes"],
  "properties": {
    "ingestion_id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "source": {"type": "string", "const": "x"},
    "post_id": {"type": ["string", "null"], "minLength": 1},
    "member_id": {"type": "string", "minLength": 1},
    "published_at": {"type": "string", "format": "date-time"},
    "discovered_at": {"type": "string", "format": "date-time"},
    "source_url": {"type": "string", "format": "uri"},
    "post_text": {"type": "string"},
    "media_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "classification": {"type": "string", "enum": ["weekly_schedule", "schedule_change", "sudden_stream", "cancellation", "postponement", "day_off", "irrelevant", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "discovery_source": {"type": "string", "minLength": 1},
    "source_quality": {"type": "string", "enum": ["primary", "secondary", "unknown"]},
    "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}}
  },
  "$defs": {
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "member_id", "confidence", "reason"],
      "properties": {
        "operation": {"type": "string", "enum": ["insert", "update", "cancel", "ignore"]},
        "member_id": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "time": {"type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "title": {"type": "string", "minLength": 1},
        "platform": {"type": ["string", "null"], "enum": ["youtube", "twitch", "other", null]},
        "url": {"type": ["string", "null"], "format": "uri"},
        "status": {"type": "string", "enum": ["scheduled", "changed", "cancelled", "postponed", "live", "finished", "day_off", "unknown", "tbd"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "match_event_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
