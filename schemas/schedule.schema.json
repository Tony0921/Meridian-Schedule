{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schedule",
  "type": "object",
  "additionalProperties": false,
  "required": ["updated_at", "events"],
  "properties": {
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "member_id", "date", "time", "timezone", "title", "platform", "url", "status", "origin", "source_post_id", "confidence", "updated_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "member_id": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "time": {"type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "timezone": {"type": "string", "const": "Asia/Taipei"},
        "title": {"type": "string", "minLength": 1},
        "platform": {"type": ["string", "null"], "enum": ["youtube", "twitch", "none", "unknown", "other", null]},
        "url": {"type": ["string", "null"], "format": "uri"},
        "status": {"type": "string", "enum": ["scheduled", "changed", "cancelled", "postponed", "live", "finished", "day_off", "working_day", "tbd"]},
        "origin": {"type": "string", "enum": ["weekly_schedule", "schedule_change", "sudden_stream", "cancellation", "postponement", "day_off"]},
        "source_post_id": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
