{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized schedule_ingestion CSV row",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "member_id", "date", "time", "event_status", "title", "source_url", "created_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "member_id": {"type": "string", "minLength": 1},
    "date": {"type": "string", "format": "date"},
    "time": {"type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "description": "scheduled 必須有時間；tbd/day_off/unknown 必須為 null；cancelled/postponed 可為時間或 null。跨欄位規則由 Importer 驗證。"},
    "event_status": {"type": "string", "enum": ["scheduled", "tbd", "day_off", "unknown", "cancelled", "postponed"]},
    "title": {"type": "string", "minLength": 1},
    "platform": {"type": ["string", "null"], "enum": ["youtube", "twitch", "none", "unknown", null]},
    "source_url": {"type": "string", "format": "uri"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["", "pending", "imported", "invalid"]}
  }
}
